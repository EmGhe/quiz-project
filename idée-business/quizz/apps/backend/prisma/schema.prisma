generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Source {
  id          String   @id @default(uuid())
  name        String   @unique
  type        String // 'wikidata', 'data_gouv', 'api', 'manuel'
  url         String?
  reliability Int? // 1-5
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  facts Fact[]

  @@map("sources")
}

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  parentId    String?
  icon        String?
  createdAt   DateTime @default(now())

  parent    Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryHierarchy")
  facts     Fact[]
  questions Question[]

  @@map("categories")
}

model Fact {
  id               String   @id @default(uuid())
  subject          String
  property         String
  object           String
  sourceId         String
  sourceReference  String?
  lastVerification DateTime @default(now())
  categoryId       String?
  tags             String[]
  geoRegion        String? // 'france', 'europe', 'amerique_nord', 'reste_monde'
  data             Json?
  interestScore    Int? // 1-10
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  createdBy        String?

  source    Source        @relation(fields: [sourceId], references: [id])
  category  Category?     @relation(fields: [categoryId], references: [id])
  questions Question[]
  history   FactHistory[]

  @@unique([subject, property, object])
  @@map("faits")
}

model Question {
  id                    String    @id @default(uuid())
  factId                String
  text                  String    @unique
  questionType          String    @default("texte") // 'texte', 'image', 'carte'
  mediaUrl              String?
  mediaType             String?
  mediaLicenseAuthor    String? // Author/creator from Wikimedia Commons
  mediaLicenseType      String? // e.g., "CC BY-SA 4.0", "CC0", "Public Domain"
  mediaLicenseUrl       String? // URL to license page
  mediaSourceUrl        String? // Original Wikimedia Commons page URL
  difficulty            String? // 'facile', 'moyen', 'difficile'
  difficultyScore       Int? // 1-100
  categoryId            String?
  qualityScore          Int? // 1-100
  ambiguous             Boolean   @default(false)
  displayCount          Int       @default(0)
  correctAnswersCount   Int       @default(0)
  incorrectAnswersCount Int       @default(0)
  successRate           Decimal?  @db.Decimal(5, 2)
  status                String    @default("brouillon") // 'brouillon', 'valide', 'publie', 'archive'
  enabledForDaily       Boolean   @default(true)
  enabledForMcq         Boolean   @default(false)
  validatedBy           String?
  validatedAt           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  fact            Fact                @relation(fields: [factId], references: [id])
  category        Category?           @relation(fields: [categoryId], references: [id])
  acceptedAnswers AcceptedAnswer[]
  distractors     Distractor[]
  metadata        QuestionMetadata?
  duplicates1     DetectedDuplicate[] @relation("Question1")
  duplicates2     DetectedDuplicate[] @relation("Question2")
  dailyQuestions  DailyQuestion[]

  @@map("questions")
}

model AcceptedAnswer {
  id                   String   @id @default(uuid())
  questionId           String
  answer               String
  isPrimary            Boolean  @default(false)
  variantType          String? // 'exacte', 'accent', 'abreviation', 'orthographe'
  levenshteinThreshold Int      @default(2) // Max edit distance to accept
  createdAt            DateTime @default(now())

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("reponses_acceptees")
}

model Distractor {
  id                String   @id @default(uuid())
  questionId        String
  distractorText    String
  wikidataSourceId  String? // Wikidata entity ID used to generate this distractor
  plausibilityScore Int? // 1-100, how plausible/good this distractor is
  order             Int // 1-4, order of display in MCQ
  createdAt         DateTime @default(now())

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, order])
  @@map("distractors")
}

model QuestionMetadata {
  id          String    @id @default(uuid())
  questionId  String    @unique
  successRate Decimal?  @db.Decimal(5, 2) // Cached from Question stats
  avgTimeMs   Int? // Average time to answer in milliseconds
  timesAsked  Int       @default(0)
  skipRate    Decimal?  @db.Decimal(5, 2) // % of players who skipped this question
  userReports Json? // [{userId, reason, timestamp, comment}]
  reportCount Int       @default(0)
  lastAsked   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("question_metadata")
}

model DetectedDuplicate {
  id              String    @id @default(uuid())
  question1Id     String
  question2Id     String
  similarityScore Decimal   @db.Decimal(5, 2)
  duplicateType   String // 'exact', 'reformulation', 'partiel'
  resolved        Boolean   @default(false)
  action          String? // 'fusionnee', 'conservee', 'supprimee'
  resolvedBy      String?
  resolvedAt      DateTime?
  createdAt       DateTime  @default(now())

  question1 Question @relation("Question1", fields: [question1Id], references: [id], onDelete: Cascade)
  question2 Question @relation("Question2", fields: [question2Id], references: [id], onDelete: Cascade)

  @@map("doublons_detectes")
}

model FactHistory {
  id         String   @id @default(uuid())
  factId     String
  oldObject  String?
  newObject  String?
  reason     String?
  modifiedBy String?
  modifiedAt DateTime @default(now())

  fact Fact @relation(fields: [factId], references: [id], onDelete: Cascade)

  @@map("historique_faits")
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  gold         Int      @default(0) // Virtual currency
  fragments    Int      @default(0) // Fragment currency (from card destruction)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  submissions          DailySubmission[]
  streaks              UserStreak[]
  goldTransactions     GoldTransaction[]
  fragmentTransactions FragmentTransaction[]
  packs                Pack[]
  userCards            UserCard[]
  pityCounters         UserPityCounter[]
  streakRewards        StreakReward[]

  // PvP relations
  player1Matches  PvpMatch[]        @relation("Player1Matches")
  player2Matches  PvpMatch[]        @relation("Player2Matches")
  elo             UserElo?
  missionProgress MissionProgress[]

  // Tags (for card collection organization)
  tags      Tag[]
  cardTags  CardTag[]

  @@map("users")
}

model Tag {
  id        String   @id @default(uuid())
  userId    String
  label     String
  color     String
  createdAt DateTime @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardTags  CardTag[]

  @@unique([userId, label])
  @@index([userId])
  @@map("tags")
}

model CardTag {
  id     String @id @default(uuid())
  cardId String
  tagId  String
  userId String

  card   Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([cardId, tagId, userId])
  @@index([userId])
  @@index([tagId])
  @@map("card_tags")
}

model GoldTransaction {
  id        String   @id @default(uuid())
  userId    String
  amount    Int // Positive for earning, negative for spending
  reason    String // 'daily_completion', 'pvp_victory', 'pack_purchase', etc.
  metadata  Json? // Additional context (dailyId, matchId, etc.)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([reason])
  @@map("gold_transactions")
}

model FragmentTransaction {
  id        String   @id @default(uuid())
  userId    String
  amount    Int      // Positive for earning (destruction), negative for spending (upgrade)
  reason    String   // 'card_destruction', 'card_upgrade'
  metadata  Json?    // {cardId, fromRarity, toRarity}
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("fragment_transactions")
}

enum PackType {
  BRONZE
  SILVER
  GOLD
}

model PackConfig {
  id              String   @id @default(uuid())
  type            PackType @unique
  cost            Int      // 500, 1200, 3000
  cardCount       Int      @default(5)

  // Probabilities (percentages)
  commonChance    Int      // 65, 45, 20
  rareChance      Int      // 28, 40, 45
  epicChance      Int      // 7, 13, 30
  legendaryChance Float    // 0.5, 2, 5

  // Guarantees
  minRares        Int      // 1, 2, 2
  minEpics        Int      // 0, 0, 1

  // Pity systems
  epicPityCount      Int   // 6, 3, 0
  legendaryPityCount Int   // 25, 12, 5

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("pack_configs")
}

model Pack {
  id        String    @id @default(uuid())
  userId    String
  type      PackType
  cost      Int
  opened    Boolean   @default(false)
  cards     Json?     // [{cardId, rarity}, ...] generated on opening
  openedAt  DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, opened])
  @@map("packs")
}

model UserPityCounter {
  id                        String   @id @default(uuid())
  userId                    String
  packType                  PackType
  packsOpenedSinceLegendary Int      @default(0)
  packsOpenedSinceEpic      Int      @default(0)

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, packType])
  @@map("user_pity_counters")
}

model UserCard {
  id          String    @id @default(uuid())
  userId      String
  cardId      String
  rarity      String    // Current rarity (can evolve)
  baseRarity  String    // Original rarity
  isFavorite  Boolean   @default(false)
  obtainedAt  DateTime  @default(now())
  upgradedAt  DateTime?

  user User @relation(fields: [userId], references: [id])
  card Card @relation(fields: [cardId], references: [id])

  @@unique([userId, cardId]) // One user can have ONE instance of a card
  @@index([userId])
  @@map("user_cards")
}

model StreakReward {
  id          String   @id @default(uuid())
  userId      String
  streakLevel Int      // 5, 10, 20, 30, 50, 75, 100
  rewardGold  Int
  claimedAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, streakLevel]) // Each streak level rewarded once
  @@map("streak_rewards")
}

model UserStreak {
  id            String   @id @default(uuid())
  userId        String
  currentStreak Int      @default(0)
  longestStreak Int      @default(0)
  lastDailyDate String? // YYYY-MM-DD format, UTC
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
  @@map("user_streaks")
}

model Daily {
  id          String   @id @default(uuid())
  dailyNumber Int      @unique
  date        String   @unique // YYYY-MM-DD format, UTC
  createdAt   DateTime @default(now())

  questions   DailyQuestion[]
  submissions DailySubmission[]

  @@map("dailies")
}

model DailyQuestion {
  id         String @id @default(uuid())
  dailyId    String
  questionId String
  order      Int // 1-10

  daily    Daily    @relation(fields: [dailyId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id])

  @@unique([dailyId, order])
  @@map("daily_questions")
}

model DailySubmission {
  id           String   @id @default(uuid())
  userId       String
  dailyId      String
  score        Int
  totalTime    Int // milliseconds
  correctCount Int
  answersData  Json // [{questionId, answer, correct, timeMs, pointsEarned}]
  submittedAt  DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  daily Daily @relation(fields: [dailyId], references: [id], onDelete: Cascade)

  @@unique([userId, dailyId])
  @@index([dailyId, score])
  @@map("daily_submissions")
}

// ==========================================
// MVP3 - Collection Models
// ==========================================

model Entity {
  id              String   @id @default(uuid())
  wikidataId      String   @unique
  label           String
  type            String

  pageviewsMonth  Int
  wikiTextLength  Int
  rarityScore     Float

  description     String   @db.Text
  wikidataUrl     String
  wikipediaUrl    String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  card            Card?

  @@map("entities")
}

model Card {
  id          String   @id @default(uuid())
  entityId    String   @unique

  rarity      String
  imageUrl    String
  imageWidth  Int
  imageHeight Int

  imageLicenseAuthor  String?
  imageLicenseType    String?
  imageLicenseUrl     String?
  imageSourceUrl      String?

  displayOrder Int?
  active       Boolean @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  entity      Entity      @relation(fields: [entityId], references: [id])
  albums      CardAlbum[]
  userCards   UserCard[]  // Users who own this card
  tags        CardTag[]

  @@map("cards")
}

model Album {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  description String?
  icon        String?
  displayOrder Int

  createdAt   DateTime @default(now())

  cards       CardAlbum[]

  @@map("albums")
}

model CardAlbum {
  id       String @id @default(uuid())
  cardId   String
  albumId  String

  card     Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)
  album    Album  @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@unique([cardId, albumId])
  @@map("card_albums")
}

// ==========================================
// MVP2 - PvP Models
// ==========================================

enum MatchStatus {
  waiting
  category_ban
  in_progress
  completed
  cancelled
}

model PvpMatch {
  id     String      @id @default(uuid())
  status MatchStatus @default(waiting)

  // Players
  player1Id String
  player2Id String

  // Category ban phase
  player1BannedCat String[] // Category IDs banned by player 1
  player2BannedCat String[] // Category IDs banned by player 2

  // Match data
  questionIds String[] // 10 question IDs for this match

  // Results
  player1Score Int     @default(0)
  player2Score Int     @default(0)
  player1Time  Int     @default(0) // Total time in ms
  player2Time  Int     @default(0)
  winnerId     String?

  // ELO changes
  player1EloChange Int @default(0)
  player2EloChange Int @default(0)

  // Metadata
  metadata    Json? // Stores questions, player answers, and other match data
  seasonId    String?
  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?

  player1 User    @relation("Player1Matches", fields: [player1Id], references: [id], onDelete: Cascade)
  player2 User    @relation("Player2Matches", fields: [player2Id], references: [id], onDelete: Cascade)
  season  Season? @relation(fields: [seasonId], references: [id])

  @@index([player1Id, createdAt])
  @@index([player2Id, createdAt])
  @@index([status])
  @@map("pvp_matches")
}

model UserElo {
  id     String @id @default(uuid())
  userId String @unique

  // Current ELO
  elo      Int    @default(1200)
  rank     String @default("Bronze") // Bronze, Silver, Gold, Platinum, Diamond, Master, Grandmaster
  division Int    @default(3) // 3 = lowest, 1 = highest within rank

  // Season data
  seasonId         String?
  placementMatches Int     @default(0) // 0-5, first 5 games are placement

  // Stats
  totalMatches Int @default(0)
  wins         Int @default(0)
  losses       Int @default(0)
  winStreak    Int @default(0)
  highestElo   Int @default(1200)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  season     Season?      @relation(fields: [seasonId], references: [id])
  eloHistory EloHistory[]

  @@index([elo])
  @@index([seasonId, elo])
  @@map("user_elo")
}

model EloHistory {
  id        String @id @default(uuid())
  userEloId String

  matchId String
  oldElo  Int
  newElo  Int
  change  Int

  createdAt DateTime @default(now())

  userElo UserElo @relation(fields: [userEloId], references: [id], onDelete: Cascade)

  @@index([userEloId, createdAt])
  @@map("elo_history")
}

model Season {
  id     String @id @default(uuid())
  name   String @unique
  number Int    @unique

  startDate DateTime
  endDate   DateTime
  active    Boolean  @default(false)

  // Rewards (in Gold)
  rewards Json? // { "Bronze": 100, "Silver": 250, ... }

  createdAt DateTime @default(now())

  matches  PvpMatch[]
  userElos UserElo[]

  @@index([active])
  @@map("seasons")
}

model WeeklyMission {
  id String @id @default(uuid())

  type   String // 'win_pvp', 'play_daily', 'answer_correct', 'category_accuracy'
  target Int // Target value (e.g., 5 wins, 100 correct answers)
  reward Int // Gold reward

  // Category-specific (optional)
  categoryId String?

  // Week period
  weekStart DateTime // Monday 00:00 UTC
  weekEnd   DateTime // Calculated as weekStart + 7 days in application

  createdAt DateTime @default(now())

  progress MissionProgress[]

  @@index([weekStart, weekEnd])
  @@map("weekly_missions")
}

model MissionProgress {
  id        String @id @default(uuid())
  userId    String
  missionId String

  progress  Int       @default(0)
  completed Boolean   @default(false)
  claimedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission WeeklyMission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@unique([userId, missionId])
  @@index([userId, completed])
  @@map("mission_progress")
}
